# =========================================================
# QR-Store Unified Environment Variables (Dokploy Deployment)
# =========================================================

# --- BACKEND CONFIGURATION ---
APP_ENV=production
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=disable
JWT_SECRET=replace-with-your-jwt-secret-key-min-32-chars
PAYMENT_PROVIDER=mock
CORS_ORIGINS=*

# Optional payment keys (if using Midtrans):
# PAYMENT_API_KEY=
# PAYMENT_SECRET=
# PAYMENT_WEBHOOK_SECRET=

# --- FRONTEND CONFIGURATION ---
# Catatan: VITE_API_URL dan VITE_WS_URL sekarang otomatis mendeteksi domain browser (Auto-Detect).
# Anda TIDAK PERLU mengisinya lagi kecuali ingin mengarahkan ke domain eksternal lain.
# VITE_API_URL=
# VITE_WS_URL=

# Google Apps Script Web App untuk upload bukti bayar ke Google Drive
VITE_GDRIVE_UPLOAD_URL=https://script.google.com/macros/s/AKfycbyU1JH6bhyUALSodmzt4vyqneMx3_vI0V7WxS7VCiAJGZ904JVcgg8_YVulTrn5lD8jnA/exec
