# =========================================================
# QR-Store Unified Environment Variables (Dokploy / Docker)
# =========================================================

# --- BACKEND CONFIGURATION ---
APP_ENV=production
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=disable

# WAJIB. Minimal 32 karakter acak (mis. `openssl rand -base64 48`).
# Aplikasi akan MENOLAK start di produksi jika kosong/lemah/nilai default.
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars

# Pembayaran. Di produksi JANGAN gunakan 'mock'.
PAYMENT_PROVIDER=midtrans
PAYMENT_API_KEY=
PAYMENT_SECRET=
# WAJIB di produksi. Digunakan untuk verifikasi signature webhook (HMAC/SHA).
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Allowlist origin yang diizinkan (dipisah koma). JANGAN '*' di produksi.
# Contoh: https://qrstore.example.com,https://admin.example.com
CORS_ORIGINS=https://qrstore.example.com

# Set true HANYA untuk development/demo agar data contoh ikut di-seed.
SEED_DEMO_DATA=false

# --- FRONTEND CONFIGURATION ---
# VITE_API_URL dan VITE_WS_URL otomatis mendeteksi domain browser (Auto-Detect).
# Isi hanya jika ingin mengarahkan ke domain eksternal lain.
# VITE_API_URL=
# VITE_WS_URL=

# Google Apps Script Web App untuk upload bukti bayar ke Google Drive.
# WAJIB. Nilai default yang di-hardcode sudah DIHAPUS.
VITE_GDRIVE_UPLOAD_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec

# Shared secret untuk operasi delete file di GAS.
# Harus SAMA dengan Script Property `BUCKET_DELETE_SECRET` pada project Apps Script.
VITE_GDRIVE_DELETE_SECRET=replace-with-a-long-random-secret
