# Environment Mode: development / production
APP_ENV=production

# Server Port (Dokploy Container Port: 8080)
APP_PORT=8080

# PostgreSQL Connection String
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=disable

# JWT Secret Key for Authentication
JWT_SECRET=your-secure-random-jwt-secret-key-min-32-chars

# Payment Provider: mock / midtrans
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Allowed CORS Origins (separated by comma, or * for all)
CORS_ORIGINS=https://kantinjepang.swyu.my.id,http://localhost:5173,http://localhost:3000
