# Backend REST API Base URL (Must include protocol http:// or https:// and /api/v1)
# Local: http://localhost:8080/api/v1
# Production: https://qrstore.rijalulfikri.my.id/api/v1
VITE_API_URL=https://qrstore.rijalulfikri.my.id/api/v1

# Backend WebSocket URL (ws:// for HTTP, wss:// for HTTPS)
# Local: ws://localhost:8080/ws
# Production: wss://qrstore.rijalulfikri.my.id/ws
VITE_WS_URL=wss://qrstore.rijalulfikri.my.id/ws

# Google Apps Script Web App URL for payment proof uploads
VITE_GDRIVE_UPLOAD_URL=https://script.google.com/macros/s/AKfycbyU1JH6bhyUALSodmzt4vyqneMx3_vI0V7WxS7VCiAJGZ904JVcgg8_YVulTrn5lD8jnA/exec
