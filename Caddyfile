{
	admin off
	auto_https off
}

:{$CADDY_PORT:80} {
	# Filter noise: skip static assets from access log
	@skip_logs {
		path /_app/* /favicon.ico /favicon.png *.js *.css *.png *.jpg *.jpeg *.svg *.woff2 *.webp
	}
	log_skip @skip_logs

	# Real-time WebSocket connection
	handle /ws* {
		reverse_proxy {$BACKEND_HOST:127.0.0.1}:{$APP_PORT:8080}
	}

	# REST API Endpoints
	handle /api/* {
		reverse_proxy {$BACKEND_HOST:127.0.0.1}:{$APP_PORT:8080}
	}

	# Public Health Check
	handle /health* {
		reverse_proxy {$BACKEND_HOST:127.0.0.1}:{$APP_PORT:8080}
	}

	# SvelteKit Web Application
	handle {
		reverse_proxy {$FRONTEND_HOST:127.0.0.1}:{$FRONTEND_PORT:3000}
	}

	encode zstd gzip

	log {
		output stdout
		format console
	}
}
